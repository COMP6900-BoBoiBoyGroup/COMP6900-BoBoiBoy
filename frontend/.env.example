# .env.example
# Copy this file to ".env.local" and fill in real values for local dev.
# On Vercel, set the same keys under Project Settings -> Environment Variables.

# This is the base URL of the backend. Our /api/predict route sends the
# uploaded photo here. Example: https://your-backend.onrender.com
BACKEND_API_URL=http://localhost:8000

# This is the path on the backend that actually accepts the photo upload,
# added onto the end of BACKEND_API_URL. If you don't set this, it
# defaults to "/predict".
BACKEND_PREDICT_PATH=/predict

# This would be a shared secret sent to the backend so it knows the
# request really came from our frontend. The backend doesn't check for
# one yet, so this can be left blank for now.
BACKEND_API_KEY=

# Set this to "true" to make /api/predict skip the real backend and just
# return a random fake result instead. Useful for trying out the frontend
# before the backend is ready, or if the backend happens to be down.
NEXT_PUBLIC_DEMO_MODE=false
