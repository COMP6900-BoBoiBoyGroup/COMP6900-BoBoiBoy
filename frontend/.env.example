# .env.example
# Copy this file to ".env.local" for local development and fill in real values.
# Vercel: set the same keys under Project Settings -> Environment Variables.

# Base URL of the backend service that the frontend's /api/predict route
# forwards uploaded images to. The backend is responsible for calling the
# trained CNN model (directly, or via a hosted model inference API) and
# returning a JSON prediction. Example: https://your-backend.onrender.com
BACKEND_API_URL=http://localhost:8000

# Optional path on the backend that accepts the image upload, appended to
# BACKEND_API_URL. Defaults to "/predict" if not set.
BACKEND_PREDICT_PATH=/predict

# Optional shared secret sent as a header to the backend so it can verify
# requests are coming from this frontend. Leave blank if not used.
BACKEND_API_KEY=

# When set to "true", the /api/predict route skips the real backend call and
# returns a random mock prediction instead. Useful for developing and
# demonstrating the frontend UI before the model backend is ready/deployed.
NEXT_PUBLIC_DEMO_MODE=false
